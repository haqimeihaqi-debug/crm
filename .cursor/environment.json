{
  "build": {
    "dockerfile": "Dockerfile",
    "context": ".."
  },
  "install": "corepack enable && yarn install",
  "start": "(sudo service docker start || service docker start || true) && bash packages/twenty-utils/setup-dev-env.sh --docker",
  "terminals": [
    {
      "name": "Development Server",
      "command": "yarn start"
    }
  ],
  "ports": [
    {
      "name": "Twenty server",
      "port": 3000
    },
    {
      "name": "Twenty frontend",
      "port": 3001
    }
  ]
}
